---
layout: base.njk
bodyClass: doc
pagination:
  data: collections.problemsWithLetters
  size: 1
  alias: pr
permalink: "/problems/{{ pr.id }}/"
eleventyComputed:
  title: "{{ pr.name }}: letters from great minds | Letterlight"
  description: "What would Seneca, Rumi or Tolstoy say about {{ pr.name | lower }}? Imagined letters written with AI, with real quotes and questions to write about."
---
<main>
{% include "page-top.njk" %}
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Letterlight</a> › <span>{{ pr.name }}</span></nav>
<h1>{{ pr.name }}: letters from great minds</h1>
<section aria-labelledby="hub-letters">
  <h2 id="hub-letters">Letters</h2>
  <ul>
  {%- for p in collections.letters | byProblem(pr.id) %}
    <li><a href="{{ p.url }}">{{ (p.data.mentor | mentor).name }}: {{ p.data.title }}</a></li>
  {%- endfor %}
  </ul>
</section>
{%- if pr.sensitive %}{% set problemData = pr %}{% include "crisis.njk" %}{% endif %}
{% include "page-foot.njk" %}
</main>
