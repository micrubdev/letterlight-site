  <div class="circles">
    <div class="circle"><h3>Ancient wisdom</h3><ul><li>Marcus Aurelius</li><li>Seneca</li><li>Lao Tzu</li><li>Rumi</li><li>Carl Jung</li><li>Future You</li></ul></div>
