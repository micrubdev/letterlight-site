---
layout: base.njk
---
<main>
{% include "page-top.njk" %}
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Letterlight</a> › <a href="/facts/">True stories</a> › <a href="/mentors/{{ mentor }}/">{{ mentorData.name }}</a></nav>
<article>
  <h1>{{ title }}</h1>
  <p class="ai-label">Retold with AI from the source listed under each story. Legends are marked.</p>
{{ content | safe }}
  <ol class="facts">
  {%- for f in facts %}
    <li class="fact{% if f.status == 'legend' %} fact-legend{% endif %}">
      <h2>{{ f.title }}</h2>
      <p>{% if f.status == 'legend' %}<span class="legend-tag">Legend</span>{% endif %}{{ f.text }}</p>
      <p class="source">Source: <a href="{{ f.source_url }}">{{ f.source }}</a></p>
    </li>
  {%- endfor %}
  </ol>
</article>
{%- set letters = collections.letters | byMentor(mentor) %}
{%- if letters.length %}
<section class="related" aria-labelledby="rel-letters">
  <h2 id="rel-letters">Imagined letters from {{ mentorData.name }}</h2>
  <ul>
  {%- for p in letters %}
    <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
  {%- endfor %}
  </ul>
</section>
{%- endif %}
{% include "page-foot.njk" %}
</main>
